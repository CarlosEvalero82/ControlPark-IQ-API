            "name": "Registro",
            "item": [
                {
                    "name": "1 · Registro correcto",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Código HTTP 201', function () { pm.response.to.have.status(201); });",
                                    "pm.test('Mensaje: Usuario registrado correctamente', function () { pm.expect(pm.response.json().mensaje).to.eql('Usuario registrado correctamente'); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"usuario\": \"porteria.torre1\",\n    \"contrasena\": \"Parque2026\",\n    \"rol\": \"PORTERIA\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/registro",
                            "host": [
                                "{{baseUrl}}"
                            ],
