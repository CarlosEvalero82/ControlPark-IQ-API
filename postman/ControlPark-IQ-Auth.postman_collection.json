        "name": "ControlPark-IQ · Servicio Auth (GA7-220501096-AA5)",
        "description": "Pruebas del servicio web de registro e inicio de sesión de ControlPark-IQ. Ejecutar en orden con el proyecto corriendo en http://localhost:8080. Si se repite la colección, cambie el usuario o vacíe la tabla usuarios.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        }
